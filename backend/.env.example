# ============================================================
#  BACKEND SECRETS  — copy to backend/.env and fill real values
#  (.env is gitignored; never commit real keys)
# ============================================================

# ---- LiveKit Cloud ----
# Create a free project at https://cloud.livekit.io and copy URL/key/secret here.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=your_secret

# ---- Deepgram (STT) ----
DEEPGRAM_API_KEY=your_deepgram_key
# flux-general-en: ends the turn from the words, not a fixed silence (nova-3 still works)
DEEPGRAM_MODEL=flux-general-en

# ---- ElevenLabs (TTS) ----
ELEVEN_API_KEY=your_elevenlabs_key
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVEN_VOICE_ID=aMSt68OGf4xUZAnLpTU8
ELEVEN_MODEL=eleven_flash_v2_5

# ---- Anthropic Claude (LLM + call summary) ----
# Create a key at https://platform.claude.com (Settings -> API keys)
ANTHROPIC_API_KEY=your_anthropic_key
# claude-opus-4-6 (~1.8 s first token) or claude-sonnet-5-5 (~1.1 s, faster)
LLM_MODEL=claude-opus-4-6
# Not CLAUDE_*: the Claude tools set CLAUDE_EFFORT on dev machines and it would win.
# low = fastest first word in a voice call (measured ~0.85 s)
LLM_EFFORT=low

# ---- Token server ----
TOKEN_SERVER_PORT=8000

# ---- GREEN-API (WhatsApp export) ----
GREENAPI_HOST=https://api.green-api.com
GREENAPI_ID=your_instance_id
GREENAPI_TOKEN=your_api_token

# ---- Email export (SMTP app password, not OAuth) ----
# Gmail: create an App Password at https://myaccount.google.com/apppasswords (needs 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Iklipse Voice <your_email@gmail.com>
